+def retry_with_exponential_backoff(initial_delay: 1, exponential_base: 2, jitter: true, max_retries: 10)
+  retries = 0
+  delay = initial_delay
+  begin
+    yield
+  rescue OpenAI::Errors::RateLimitError
+    raise if retries >= max_retries
+
+    retries += 1
+    delay *= exponential_base * (1 + (jitter ? rand : 0))
+    sleep(delay)
+    retry
+  end
+end
